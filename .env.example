# === 通知設定 ===
# 設定した全チャンネルに同時通知されます。使わないものは空欄にしてください。

# --- Email (SMTP) ---
# GmailはアプリパスワードをSMTP_PASSWORDに設定してください（README参照）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_TO=destination@gmail.com

# --- Discord Webhook（オプション）---
DISCORD_WEBHOOK_URL=

# --- Telegram Bot（オプション）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack Webhook（オプション）---
SLACK_WEBHOOK_URL=

# === AI要約設定 ===
# Anthropic API Key（要約機能を使う場合）
ANTHROPIC_API_KEY=sk-ant-...

# 要約に使うモデル（デフォルト: claude-haiku-4-5-20251001）
SUMMARIZER_MODEL=claude-haiku-4-5-20251001

# === 実行設定 ===
# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# データ保存ディレクトリ
DATA_DIR=data

# リクエスト間の待機秒数（過剰アクセス防止）
REQUEST_DELAY_SECONDS=2

# 要約機能を有効にする（true / false）
ENABLE_SUMMARIZER=true

# 通知を送信するか（false にするとドライラン）
ENABLE_NOTIFICATIONS=true
